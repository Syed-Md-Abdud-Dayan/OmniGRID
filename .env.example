# Copy to .env and fill in your SSLCOMMERZ sandbox credentials.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# Public HTTPS URL that forwards to this Flask backend (needed for gateway callbacks).
SSLCOMMERZ_CALLBACK_BASE_URL=https://your-public-backend-url
FRONTEND_BASE_URL=http://localhost:5173
